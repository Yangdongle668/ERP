# ERP Docker 部署配置。deploy.sh 首次运行时复制为 .env 并自动生成密码与密钥；.env 不要提交到 Git。

# 访问端口（浏览器打开 http://服务器IP:端口）
ERP_HTTP_PORT=80

# 数据库（MySQL 8，容器内部使用，不对外暴露端口）
ERP_DB_NAME=erp
ERP_DB_USER=erp
ERP_DB_PASSWORD=
ERP_DB_ROOT_PASSWORD=

# 登录令牌签名密钥（至少 32 位随机字符串；修改后所有用户需重新登录）
ERP_JWT_SECRET=

# 敏感参数（如 AI API Key）的加密密钥；为空时使用 ERP_JWT_SECRET。设置后不要再修改，否则已保存的密钥需要重新填写
ERP_SECRET_KEY=

# AI 分析（可选）：DeepSeek / 通义千问等 OpenAI 兼容接口的 API Key；也可在“系统参数”页面配置
ERP_AI_API_KEY=
ERP_AI_BASE_URL=

# 内存配置：deploy.sh 首次运行时按服务器内存自动选择（low：≤ 3.5GB 内存；standard：其他），之后可手工修改
ERP_MEMORY_PROFILE=
# JVM 参数（standard：堆上限 1GB）
JAVA_OPTS="-Xms256m -Xmx1024m -XX:+UseG1GC -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"
# MySQL 缓冲池与性能监控（low 时为 128M / OFF）
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_PERFORMANCE_SCHEMA=ON

# 构建加速（国内服务器建议启用，deploy.sh --cn 会自动填写）
MAVEN_MIRROR=
NPM_REGISTRY=

# 镜像标签
ERP_IMAGE_TAG=latest

# HTTPS（./deploy.sh --https）：已解析到本机的域名，Caddy 自动申请 Let's Encrypt 证书
ERP_DOMAIN=
ERP_HTTPS=
# 监控（./deploy.sh --monitoring）：Prometheus 抓取 /actuator/prometheus 的令牌（deploy.sh 自动生成）
ERP_MONITORING=
ERP_METRICS_TOKEN=
# 告警通知（可选）：Alertmanager 通过 Webhook 推送（如企业微信 / 钉钉机器人转发服务地址）
ALERT_WEBHOOK_URL=

# 备份（backup.sh；update.sh 更新前也会备份数据库）
# 每类（数据库 / 附件）保留份数
BACKUP_KEEP=10
# 备份目录（默认项目下 backups/）
BACKUP_DIR=
# 定时备份时间（cron 格式，./backup.sh --install-cron 安装），默认每天 02:30
BACKUP_CRON="30 2 * * *"
# 异地复制：rsync/scp 地址（user@host:/data/erp-backup）或 rclone:远端名:路径；为空不复制
BACKUP_REMOTE=
