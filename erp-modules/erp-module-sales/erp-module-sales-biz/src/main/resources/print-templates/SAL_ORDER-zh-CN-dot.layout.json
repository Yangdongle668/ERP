{
  "version": 1,
  "title": "销售订单",
  "subtitle": "{{#if orderVersion}}V{{orderVersion}}{{/if}}",
  "date": "{{formatDate docDate}}",
  "header": {
    "logo": true,
    "nameEn": true,
    "barcode": true
  },
  "info": [
    {
      "key": "customerCode",
      "label": "客户编号",
      "expr": "{{customerCode}}",
      "span": 1,
      "visible": true
    },
    {
      "key": "currency",
      "label": "币别",
      "expr": "{{currency}}",
      "span": 1,
      "visible": true
    },
    {
      "key": "paymentTermName",
      "label": "付款条件",
      "expr": "{{paymentTermName}}",
      "span": 1,
      "visible": true
    },
    {
      "key": "ownerName",
      "label": "业务员",
      "expr": "{{ownerName}}",
      "span": 1,
      "visible": true
    },
    {
      "key": "tradeTerm",
      "label": "贸易条款",
      "expr": "{{tradeTerm}}",
      "span": 1,
      "visible": true
    },
    {
      "key": "taxIncludedText",
      "label": "含税",
      "expr": "{{taxIncludedText}}",
      "span": 1,
      "visible": true
    },
    {
      "key": "orderVersion",
      "label": "版本",
      "expr": "{{orderVersion}}",
      "span": 2,
      "visible": true
    }
  ],
  "columns": [
    {
      "key": "seq",
      "label": "序",
      "width": 8,
      "expr": "{{lineNo}}",
      "align": "center",
      "visible": true
    },
    {
      "key": "materialCode",
      "label": "物料编码",
      "width": 32,
      "expr": "{{materialCode}}",
      "align": "left",
      "visible": true
    },
    {
      "key": "description",
      "label": "品名规格",
      "width": 84,
      "expr": "{{description}}",
      "align": "left",
      "visible": true
    },
    {
      "key": "uom",
      "label": "单位",
      "width": 12,
      "expr": "{{uom}}",
      "align": "center",
      "visible": true
    },
    {
      "key": "qty",
      "label": "数量",
      "width": 22,
      "expr": "{{decAlign (formatQty qty) 3}}",
      "align": "right",
      "visible": true,
      "total": {
        "kind": "qty",
        "field": "qty"
      }
    },
    {
      "key": "price",
      "label": "单价",
      "width": 20,
      "expr": "{{decAlign (formatPrice price) 4}}",
      "align": "right",
      "visible": true
    },
    {
      "key": "amount",
      "label": "金额",
      "width": 26,
      "expr": "{{decAlign (formatAmount amount) 2}}",
      "align": "right",
      "visible": true,
      "total": {
        "kind": "amount",
        "field": "amount",
        "docExpr": "amount"
      }
    },
    {
      "key": "deliveryDate",
      "label": "交期",
      "width": 18,
      "expr": "{{formatDate deliveryDate}}",
      "align": "center",
      "visible": true
    }
  ],
  "memo": {
    "visible": true,
    "expr": "税额：{{formatAmount taxAmount}}　价税合计：{{formatAmount totalAmount}}{{#if (eq currency \"CNY\")}}（{{amountInWordsCn totalAmount}}）{{/if}}　备注：{{remark}}"
  },
  "signs": [
    {
      "key": "s1",
      "label": "制单",
      "expr": "{{createdByName}}",
      "wide": false,
      "visible": true
    },
    {
      "key": "s2",
      "label": "审核",
      "expr": "{{auditByName}}",
      "wide": false,
      "visible": true
    },
    {
      "key": "s3",
      "label": "业务员",
      "expr": "{{ownerName}}",
      "wide": false,
      "visible": true
    },
    {
      "key": "s4",
      "label": "客户确认（签字/盖章）",
      "expr": "",
      "wide": true,
      "visible": true
    }
  ],
  "footer": {
    "printInfo": true,
    "address": true
  },
  "fontSize": 8.5,
  "paper": "DOT_241_140",
  "margin": "5mm 6mm 4mm 6mm",
  "rowsPerPage": 16,
  "copies": "①白 存根|②红 客户"
}
